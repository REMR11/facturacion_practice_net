@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    decimal ToDecimal(object? value) => value == null ? 0m : Convert.ToDecimal(value);
    decimal ingresosMes = ToDecimal(ViewBag.IngresosDelMes);
    decimal cambioIngresos = ToDecimal(ViewBag.CambioIngresos);
    int facturasEmitidas = ViewBag.FacturasEmitidas ?? 0;
    decimal cambioFacturas = ToDecimal(ViewBag.CambioFacturas);
    int clientesActivos = ViewBag.ClientesActivos ?? 0;
    decimal cambioClientes = ToDecimal(ViewBag.CambioClientes);
    decimal tasaCobro = ToDecimal(ViewBag.TasaDeCobro);
    decimal cambioTasaCobro = ToDecimal(ViewBag.CambioTasaCobro);

    string CambioEtiqueta(decimal valor) => string.Format("{0:+0.0;-0.0;0}", valor);
    string CambioIcono(decimal valor) => valor >= 0 ? "fa-arrow-trend-up text-success" : "fa-arrow-trend-down text-danger";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="fas fa-chart-line me-2"></i>Dashboard</h1>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Facturas" asp-action="Create"><i class="fas fa-plus me-1"></i>Crear factura</a>
            <a class="btn btn-outline-primary" asp-controller="Inventario" asp-action="Index"><i class="fas fa-warehouse me-1"></i>Ver inventario</a>
            <a class="btn btn-outline-secondary" asp-controller="Clientes" asp-action="Create"><i class="fas fa-user-plus me-1"></i>Registrar cliente</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Ingresos del mes</span>
                        <i class="fas fa-coins text-warning"></i>
                    </div>
                    <h4 class="mb-1">@ingresosMes.ToString("C")</h4>
                    <small class="text-muted"><i class="fas @CambioIcono(cambioIngresos) me-1"></i>@CambioEtiqueta(cambioIngresos)% vs mes anterior</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Facturas emitidas</span>
                        <i class="fas fa-file-invoice text-info"></i>
                    </div>
                    <h4 class="mb-1">@facturasEmitidas</h4>
                    <small class="text-muted"><i class="fas @CambioIcono(cambioFacturas) me-1"></i>@CambioEtiqueta(cambioFacturas)% vs mes anterior</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Clientes activos</span>
                        <i class="fas fa-users text-success"></i>
                    </div>
                    <h4 class="mb-1">@clientesActivos</h4>
                    <small class="text-muted"><i class="fas @CambioIcono(cambioClientes) me-1"></i>@CambioEtiqueta(cambioClientes)% vs mes anterior</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Tasa de cobro</span>
                        <i class="fas fa-chart-pie text-primary"></i>
                    </div>
                    <h4 class="mb-1">@tasaCobro.ToString("P2")</h4>
                    <small class="text-muted"><i class="fas @CambioIcono(cambioTasaCobro) me-1"></i>@CambioEtiqueta(cambioTasaCobro)% vs mes anterior</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ingresos mensuales</h5>
                    <p class="text-muted small mb-3">Evolución de los últimos 7 meses</p>
                    <div style="height: 280px;">
                        <canvas id="chartIngresos"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Acciones rápidas</h5>
                    <a class="btn btn-primary w-100 mb-2" asp-controller="Facturas" asp-action="Create"><i class="fas fa-plus me-2"></i>Nueva factura</a>
                    <a class="btn btn-outline-secondary w-100 mb-2" asp-controller="Clientes" asp-action="Create"><i class="fas fa-user-plus me-2"></i>Registrar cliente</a>
                    <a class="btn btn-outline-primary w-100 mb-2" asp-controller="Inventario" asp-action="Index"><i class="fas fa-warehouse me-2"></i>Ver inventario</a>
                    <a class="btn btn-outline-secondary w-100" asp-controller="Productos" asp-action="Index"><i class="fas fa-box me-2"></i>Productos</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">Facturas recientes</h5>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Facturas" asp-action="Index">Ver todas</a>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.FacturasRecientes != null && ViewBag.FacturasRecientes.Count > 0)
                        {
                            foreach (var factura in ViewBag.FacturasRecientes)
                            {
                                string badgeClass = factura.Estado == Fatura.Models.Enums.EstadoFactura.Pagada ? "bg-success"
                                    : factura.Estado == Fatura.Models.Enums.EstadoFactura.Cancelada ? "bg-danger" : "bg-secondary";
                                <tr>
                                    <td><strong>#@factura.IdFactura</strong></td>
                                    <td>@factura.ClienteNombre</td>
                                    <td>@factura.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>@factura.Total.ToString("C")</td>
                                    <td><span class="badge @badgeClass">@factura.Estado</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay facturas disponibles</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof Chart !== 'undefined') {
            var ctx = document.getElementById('chartIngresos');
            if (ctx) {
                const ingresosMensuales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.IngresosMensuales ?? new List<object>()));
                const esObjeto = ingresosMensuales && !Array.isArray(ingresosMensuales) && typeof ingresosMensuales === 'object';
                const etiquetas = esObjeto ? Object.keys(ingresosMensuales) : ingresosMensuales.map((_, i) => {
                    const date = new Date();
                    date.setMonth(date.getMonth() - (ingresosMensuales.length - 1 - i));
                    return date.toLocaleDateString('es-ES', { month: 'short' });
                });
                const valores = esObjeto ? Object.values(ingresosMensuales) : ingresosMensuales;
                if (valores && valores.length > 0) {
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: etiquetas,
                            datasets: [{
                                label: 'Ingresos',
                                data: valores,
                                borderColor: '#0d6efd',
                                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                                borderWidth: 2,
                                fill: true,
                                tension: 0.4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: { callback: v => '$' + v.toLocaleString() }
                                }
                            }
                        }
                    });
                }
            }
        }
    });
</script>
