@model IEnumerable<Fatura.Models.Facturacion.Cliente>

@{
    ViewData["Title"] = "Listado de Clientes";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="fas fa-users me-2"></i>Clientes</h1>
        <div>
            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-arrow-left me-1"></i>Volver</a>
            <a class="btn btn-primary" asp-action="Create"><i class="fas fa-user-plus me-1"></i>Nuevo cliente</a>
        </div>
    </div>

    <div class="card">
        @if (Model == null || !Model.Any())
        {
            <div class="card-body text-center text-muted py-5">
                <i class="fas fa-user-group fa-3x mb-3"></i>
                <p class="mb-0">Aún no hay clientes registrados.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@cliente.Nombre</strong>
                                    <br /><small class="text-muted">@cliente.NitDui</small>
                                </td>
                                <td>@cliente.Email</td>
                                <td>@cliente.Telefono</td>
                                <td>@cliente.Direccion</td>
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@cliente.Id" title="Editar"><i class="fas fa-pen"></i></a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@cliente.Id" title="Ver"><i class="fas fa-eye"></i></a>
                                    <form asp-action="Delete" asp-route-id="@cliente.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar al cliente @cliente.Nombre?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
