<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes" />
    <title>@ViewData["Title"] - Motos &amp; Repuestos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/fonts.css" rel="stylesheet" />
    <link href="~/css/responsive.css" rel="stylesheet" />
    <link href="~/css/productos-responsive.css" rel="stylesheet" />
    <link href="~/css/mobile-tablet.css" rel="stylesheet" />
    <link href="~/css/floating-menu.css" rel="stylesheet" />
    <style>
        body { margin: 0; padding: 0; }
        .navbar { padding-top: 0; padding-bottom: 0; min-height: 64px; }
        .navbar-nav .nav-link { display: flex; align-items: center; height: 64px; }
        .navbar-brand { color: #C0C0C0 !important; display: flex; align-items: center; gap: 0.75rem; }
        .navbar-logo { height: 50px; width: auto; object-fit: contain; }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <img src="~/LOGO.png" alt="Motos Rodriguez" class="navbar-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                <span style="display: none;">🏍️ Motos Rodriguez</span>
                <span class="d-none d-lg-inline">Motos Rodriguez</span>
            </a>

            <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu"
                    aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end d-lg-flex d-none" id="mainMenu">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home me-2 d-lg-none"></i>Inicio</a></li>
                    <li class="nav-item ms-3">
                        <a class="nav-link text-warning position-relative" asp-controller="Cart" asp-action="Index">
                            <i class="fas fa-shopping-cart fa-lg"></i>
                            <span id="cartBadge" class="badge bg-danger position-absolute top-0 start-100 translate-middle" style="display: none; font-size: 0.7rem; padding: 0.25em 0.5em;">0</span>
                        </a>
                    </li>
                    <li class="nav-item ms-2">
                        <a class="nav-link" asp-controller="AccesoAdmin" asp-action="Index" title="Entrar como administrador"><i class="fas fa-user-shield me-1"></i>Administrador</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="floating-menu-overlay d-lg-none" id="floatingMenuOverlay"></div>
    <button class="floating-menu-btn d-lg-none" id="floatingMenuBtn" aria-label="Abrir menú"><i class="fas fa-bars" id="floatingMenuIcon"></i></button>
    <div class="floating-menu-panel d-lg-none" id="floatingMenuPanel">
        <div class="floating-menu-header">
            <h5><i class="fas fa-bars me-2"></i>Menú</h5>
            <button class="floating-menu-close" id="floatingMenuClose" aria-label="Cerrar menú"><i class="fas fa-times"></i></button>
        </div>
        <div class="floating-menu-content">
            <a href="@Url.Action("Index", "Home")" class="floating-menu-item"><i class="fas fa-home"></i><span>Inicio</span></a>
            <a href="@Url.Action("Index", "Cart")" class="floating-menu-item"><i class="fas fa-shopping-cart"></i><span>Carrito</span></a>
            <a href="@Url.Action("Index", "AccesoAdmin")" class="floating-menu-item"><i class="fas fa-user-shield"></i><span>Administrador</span></a>
        </div>
        <div class="floating-cart">
            <a href="@Url.Action("Index", "Cart")" class="floating-cart-link">
                <i class="fas fa-shopping-cart"></i><span>Carrito de Compras</span>
                <span class="floating-cart-badge" id="floatingCartBadge" style="display: none;">0</span>
            </a>
        </div>
    </div>

    <main class="container-fluid px-3 px-md-4 py-3 py-md-4 flex-fill main-content">
        @RenderBody()
    </main>

    <footer class="mt-auto">
        <div class="bg-warning py-3">
            <div class="container">
                <div class="row text-center gy-2">
                    <div class="col-md-4"><i class="fas fa-map-marker-alt"></i> 3º CALLE PONIENTE #3-7B, MUNICIPIO DE SANTA TECLA DEPARTAMENTO DE LA LIBERTAD</div>
                    <div class="col-md-4"><i class="fab fa-whatsapp"></i> +503 7595-7484</div>
                    <div class="col-md-4"><i class="fas fa-envelope"></i> Jr9000390@gmail.com</div>
                </div>
            </div>
        </div>
        <div class="bg-dark text-center py-3">
            <a href="#" class="text-white mx-3 fs-4"><i class="fab fa-facebook"></i></a>
            <a href="#" class="text-white mx-3 fs-4"><i class="fab fa-instagram"></i></a>
            <a href="#" class="text-white mx-3 fs-4"><i class="fab fa-tiktok"></i></a>
        </div>
        <div class="bg-secondary text-white text-center py-2">&copy; Taller de Motos Rodriguez</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const overlay = document.getElementById('floatingMenuOverlay');
            if (overlay) { overlay.classList.remove('show'); overlay.style.display = 'none'; }
            document.body.style.display = 'block';
            document.body.style.visibility = 'visible';
            document.body.style.opacity = '1';
            updateCartBadge();
            initMobileMenu();
        });
        function updateCartBadge() {
            fetch('@Url.Action("GetCartCount", "Cart")')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('cartBadge');
                    const fb = document.getElementById('floatingCartBadge');
                    if (badge) { badge.textContent = data.count; badge.style.display = data.count > 0 ? 'inline-block' : 'none'; }
                    if (fb) { fb.textContent = data.count; fb.style.display = data.count > 0 ? 'flex' : 'none'; }
                })
                .catch(e => console.error('Error:', e));
        }
        window.updateCartCount = function(count) {
            const badge = document.getElementById('cartBadge');
            const fb = document.getElementById('floatingCartBadge');
            if (badge) { badge.textContent = count; badge.style.display = count > 0 ? 'inline-block' : 'none'; }
            if (fb) { fb.textContent = count; fb.style.display = count > 0 ? 'flex' : 'none'; }
        };
        function initMobileMenu() {
            const btn = document.getElementById('floatingMenuBtn');
            const panel = document.getElementById('floatingMenuPanel');
            const overlay = document.getElementById('floatingMenuOverlay');
            const close = document.getElementById('floatingMenuClose');
            const icon = document.getElementById('floatingMenuIcon');
            const items = document.querySelectorAll('.floating-menu-item, .floating-cart-link');
            function open() { panel?.classList.add('show'); overlay?.classList.add('show'); btn?.classList.add('active'); if (icon) icon.className = 'fas fa-times'; document.body.style.overflow = 'hidden'; }
            function closeM() { panel?.classList.remove('show'); overlay?.classList.remove('show'); btn?.classList.remove('active'); if (icon) icon.className = 'fas fa-bars'; document.body.style.overflow = ''; }
            btn?.addEventListener('click', function(e) { e.stopPropagation(); panel?.classList.contains('show') ? closeM() : open(); });
            close?.addEventListener('click', closeM);
            overlay?.addEventListener('click', closeM);
            items.forEach(i => i.addEventListener('click', () => setTimeout(closeM, 300)));
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
