@model List<Fatura.Models.Inventario.Inventario>
@using System.Linq
@{
    ViewData["Title"] = "Inventario";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">

        <!-- ===== HEADER ===== -->
        <div class="card shadow-sm mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <h3 class="fw-bold mb-0">
                    <i class="fas fa-boxes text-primary"></i> Inventario de Productos
                </h3>

                <a asp-controller="Productos" asp-action="Create" class="btn btn-success btn-lg">
                    <i class="fas fa-plus-circle"></i> Nuevo Producto
                </a>
            </div>
        </div>

        <!-- ===== TABLA ===== -->
        <div class="card shadow-sm">
            <div class="card-body table-responsive">

                <table class="table table-hover align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Stock</th>
                            <th>Precio</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="text-muted" title="Producto"><i class="fas fa-box"></i></span>
                                    </td>
                                    <td class="fw-semibold">@(item.Producto?.NombreProducto ?? "-")</td>
                                    <td>
                                        <span class="badge bg-secondary">@(item.Producto?.Categoria?.NombreCategoria ?? "-")</span>
                                    </td>
                                    <td>
                                        @if (item.Stock <= 0)
                                        {
                                            <span class="badge bg-danger">Agotado</span>
                                        }
                                        else if (item.Stock < 5)
                                        {
                                            <span class="badge bg-warning text-dark">@item.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.Stock</span>
                                        }
                                    </td>
                                    <td>@((item.Producto?.Precio ?? 0).ToString("C"))</td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.IdProducto"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.IdProducto"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-muted py-4">
                                    <i class="fas fa-box-open fa-2x mb-2"></i><br />
                                    No hay productos en el inventario
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

</div>
