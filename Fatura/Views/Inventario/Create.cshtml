@model Fatura.Models.Inventario.Inventario
@using Fatura.Models
@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">

        <!-- HEADER -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="fw-bold">
                    <i class="fas fa-plus-circle text-success"></i> Nuevo Producto
                </h3>
            </div>
        </div>

        <!-- FORMULARIO -->
        <div class="card shadow-sm">
            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div class="row g-3">

                        <!-- NOMBRE -->
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <!-- CATEGORÍA -->
                        <div class="col-md-6">
                            <label asp-for="Categoria" class="form-label"></label>
                            <input asp-for="Categoria" class="form-control" />
                            <span asp-validation-for="Categoria" class="text-danger"></span>
                        </div>

                        <!-- STOCK -->
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" type="number" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>

                       

                    </div>

                    <hr />

                    <!-- BOTONES -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Editar
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Guardar
                        </button>
                    </div>

                </form>

            </div>
        </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
