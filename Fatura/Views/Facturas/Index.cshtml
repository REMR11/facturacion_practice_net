@using Fatura.Models.Enums
@using Fatura.Models.Facturacion

@{
    ViewData["Title"] = "Facturas";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    EstadoFactura? estadoSeleccionado = ViewBag.Estado is EstadoFactura estado ? estado : null;
    DateTime? fechaInicio = ViewBag.FechaInicio as DateTime?;
    DateTime? fechaFin = ViewBag.FechaFin as DateTime?;
    string searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int total = ViewBag.Total ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="fas fa-file-invoice me-2"></i>Facturas</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Facturas" asp-action="Create">
                <i class="fas fa-plus me-1"></i>Nueva factura
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Reporte" asp-action="Index">
                <i class="fas fa-chart-pie me-1"></i>Ver reportes
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label" for="searchTerm">Buscar</label>
                    <input class="form-control" id="searchTerm" name="searchTerm" value="@searchTerm"
                           placeholder="Nº factura, cliente o NIT" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="estado">Estado</label>
                    <select class="form-select" id="estado" name="estado">
                        <option value="">Todos</option>
                        @foreach (EstadoFactura estado in Enum.GetValues(typeof(EstadoFactura)))
                        {
                            var isSelected = estadoSeleccionado.HasValue && estadoSeleccionado.Value == estado;
                            if (isSelected)
                            {
                                <option value="@estado" selected>@estado</option>
                            }
                            else
                            {
                                <option value="@estado">@estado</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="fechaInicio">Desde</label>
                    <input class="form-control" type="date" id="fechaInicio" name="fechaInicio"
                           value="@(fechaInicio?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="fechaFin">Hasta</label>
                    <input class="form-control" type="date" id="fechaFin" name="fechaFin"
                           value="@(fechaFin?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">Filtrar</button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { page = 1, pageSize })">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        @if (total > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in Model ?? Enumerable.Empty<Factura>())
                        {
                            var badgeClass = factura.Estado switch
                            {
                                EstadoFactura.Pagada => "bg-success",
                                EstadoFactura.Cancelada => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td>
                                    <strong>#@factura.IdFactura</strong>
                                    <br /><small class="text-muted">@factura.NumeroFactura</small>
                                </td>
                                <td>
                                    @factura.ClienteNombre
                                    <br /><small class="text-muted">@factura.ClienteNitDui</small>
                                </td>
                                <td>@factura.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td><strong>@($"{factura.MonedaSimbolo ?? "S/"} {factura.Total:N2}")</strong></td>
                                <td><span class="badge @badgeClass">@factura.Estado</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@factura.IdFactura" title="Ver"><i class="fas fa-eye"></i></a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@factura.IdFactura" title="Editar"><i class="fas fa-pen"></i></a>
                                    <a class="btn btn-sm btn-outline-info" asp-action="Pdf" asp-route-id="@factura.IdFactura" title="PDF"><i class="fas fa-file-pdf"></i></a>
                                    <form asp-action="Delete" asp-route-id="@factura.IdFactura" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar la factura #@factura.IdFactura?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center text-muted py-5">
                <i class="fas fa-inbox fa-3x mb-3"></i>
                <p class="mb-0">No hay facturas con los criterios seleccionados.</p>
            </div>
        }
    </div>

    @if (total > pageSize)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(page == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize, searchTerm, estado = estadoSeleccionado, fechaInicio = fechaInicio?.ToString("yyyy-MM-dd"), fechaFin = fechaFin?.ToString("yyyy-MM-dd") })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
